color-link comment "brightblack"
color-link identifier "cyan"
color-link identifier.class "green"
color-link constant "yellow"
color-link constant.string "red"
color-link constant.string.url "blue"
color-link constant.bool "bold magenta"
color-link preproc "#EDA571"
color-link identifier.macro "#EDA571"
color-link type "blue"
color-link type.keyword "bold magenta"
color-link symbol.tag "bold magenta"
color-link special "#B1ADFA"
color-link selection "brightwhite,brightblack"
color-link todo "bold brightblack"
color-link statement "bold magenta"
color-link cursor-line "brightblack"
color-link line-number "brightblack"
color-link current-line-number "white"
color-link error "brightred"
